# Supabase (service role for admin reads/writes — server only, never ship to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Port for local API server
PORT=3001

# GitHub stats proxy (optional). Without a token the public rate limit (60/hr) applies.
GITHUB_TOKEN=
GITHUB_USER=TheRowKneet68

# Optional: IP geolocation for the visitors table. Off by default.
# IP_GEOLOCATION=true

# CORS origin for the API when served separately (comma separated).
# CORS_ORIGINS=http://localhost:5173
